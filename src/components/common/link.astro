---
import { cn } from "~/lib/utils";

type Props = {
  href: string;
  className?: string;
  target?: "_blank" | "_parent" | "_self" | "_top";
};

const { href, className, target = "_self" } = Astro.props;
---

<a
  href={href}
  target={target}
  class={cn(
    "underline underline-offset-4 transition-colors delay-150 hover:text-foreground text-muted-foreground font-medium",
    className,
  )}
>
  <slot />
</a>
