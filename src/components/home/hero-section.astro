---
import Ascii from "ascii.rest/astro";
import Link from "../common/link.astro";

// Rendered at build time so the line has its final width before the script
// runs; the clock corrects it to the real hour on first tick.
const initialTime = new Intl.DateTimeFormat("en-GB", {
  timeZone: "Asia/Kolkata",
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  hourCycle: "h23",
}).format(new Date());
---

<main class="space-y-6 max-w-xl mx-auto px-4 lg:px-0">
  <div class="space-y-2">
    <Ascii piece="marine-drive" label="marine drive at night, in ascii" />
    <div class="flex items-center justify-between text-sm font-medium">
      <p>mumbai</p>
      <p data-clock class="tabular-nums">
        {initialTime}
      </p>
    </div>
  </div>

  <div class="pt-1.5">
    <h1 class="text-3xl text-foreground font-medium">
      advait <span class="text-sm text-muted-foreground">(advtszn)</span>
    </h1>
    <p class="text-sm text-muted-foreground font-medium">
      multidisciplinary engineer
    </p>
  </div>

  <div class="space-y-6 leading-[150%] tracking-wide">
    <p>
      software engineer at{" "}
      <Link href="https://wldd.in" target="_blank">
        wldd.in</Link>; prev. <Link href="/work/kimchipremium">kimchipremium.io</Link>. my
      day-to-day revolves around backend, but i'm really obsessive about good
      typography and ux
    </p>

    <div class="space-y-2">
      <p class="">btw i love shipping:</p>

      <ul class="list-disc list-inside space-y-2">
        <li>
          <Link href="/work/listable-labs">listable labs</Link>
          : built prompt eval pipeline, background job processing, multi-tenant
          blogs on custom domains etc.
        </li>

        <li>
          built <Link href="/work/kimchipremium">kimchipremium</Link>: a news
          aggregator that scrapes and publishes ~100 crypto headlines a day (278
          at peak)
        </li>

        <li>
          shipped <Link href="/work/orbe">orbe</Link>: an outreach os that
          enriches leads and writes personalized outreach emails
        </li>
      </ul>
    </div>

    <p>
      outside tech, i've dabbled in a few other things, i used to post anime
      edits, designed <Link href="/archive">cover arts</Link> and even tried
      music production for a bit.
    </p>
  </div>
</main>

<script>
  const fmt = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Asia/Kolkata",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hourCycle: "h23",
  });

  let timer: number | undefined;

  function stopClock() {
    if (timer !== undefined) clearTimeout(timer);
    timer = undefined;
  }

  function startClock() {
    stopClock();

    const el = document.querySelector<HTMLElement>("[data-clock]");
    if (!el) return;

    const tick = () => {
      el.textContent = fmt.format(new Date());
      // Re-aim at the next second boundary each time, so it never drifts and
      // flips over at the same moment a wall clock does.
      timer = window.setTimeout(tick, 1000 - (Date.now() % 1000));
    };

    tick();
  }

  startClock();
  document.addEventListener("astro:page-load", startClock);
  document.addEventListener("astro:before-swap", stopClock);
</script>
