---
import Link from "../common/link.astro";

type Props = {
  age: number;
};

const { age } = Astro.props;

---

<main class="space-y-6 max-w-xl mx-auto px-5.5 lg:px-0">
  <div class="pt-1.5 space-y-1">
    <h1 class="text-3xl text-foreground font-medium">
      advait <span class="text-base text-muted-foreground">(advtszn)</span>
    </h1>
    <p class="text-sm text-muted-foreground font-medium">
      {age}, multidisciplinary engineer
    </p>
  </div>

  <div class="space-y-6 leading-[150%]">
    <p>
      software engineer at{" "}
      <Link href="https://wldd.in" target="_blank">wldd.in</Link>
      . my daily work revolves around backend, but i'm really obsessive about
      good typography and ux
    </p>

    <div class="space-y-2">
      <p class="">btw i love shipping:</p>

      <ul class="list-disc list-inside space-y-2">
        <li>
          <Link href="/work/listable-labs">listable labs</Link>: built prompt
          eval pipeline, background job processing, multi-tenant blogs on custom
          domains etc.
        </li>

        <li>
          built <Link href="/work/kimchipremium">kimchipremium</Link>: a news
          aggregator that scrapes and publishes ~100 crypto headlines a day (278
          at peak)
        </li>

        <li>
          shipped <Link href="/work/orbe">orbe</Link>: an outreach os that
          enriches leads and writes personalized outreach emails
        </li>
      </ul>
    </div>

    <p>
      outside tech, i've dabbled in a few other things, i used to post anime
      edits, designed <Link href="/archive">cover arts</Link> and even tried
      music production for a bit.
    </p>
  </div>
</main>
