---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ArrowUpRight } from "lucide-astro";
import Link from "../common/link.astro";

const writings = (await getCollection("writings")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<section class="space-y-6">
  <div class="max-w-xl mx-auto px-4 lg:px-0">
    <div class="flex items-end justify-between border-b pb-2">
      <h2 id="writings" class="text-2xl text-foreground font-medium scroll-mt-16">writings</h2>
      <a
        href={"/writings"}
        class="inline-flex items-center gap-x-1 text-sm font-medium hover:text-foreground transition-colors"
      >
        view all
        <ArrowUpRight class="size-3" />
      </a>
    </div>
  </div>

  <div class="max-w-xl mx-auto px-4 lg:px-0">
    <ol class="space-y-2.5">
      {
        writings.map(({ id, data: { title } }) => (
          <li class="pl-1.5">
            <Link href={`/writings/${id}`}>{title}</Link>
          </li>
        ))
      }
    </ol>
  </div>
</section>
