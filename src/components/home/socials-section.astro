---
import Link from "../common/link.astro";
---

<section class="space-y-6">
  <div class="max-w-xl mx-auto px-4 lg:px-0">
    <h2 class="text-2xl text-foreground font-medium border-b pb-2">socials</h2>
  </div>

  <div class="max-w-xl mx-auto px-4 lg:px-0 space-y-2">
    <p class="leading-[150%] text-justify">
      feel free to reach out to me through any of my socials
    </p>

    <ul class="flex flex-wrap gap-x-6">
      <li class="underline underline-offset-4 font-medium">
        <Link target="_blank" href="mailto:hey@advtszn.xyz"
          >hey@advtszn.xyz</Link
        >
      </li>
      <li class="underline underline-offset-4 font-medium">
        <Link target="_blank" href="https://x.com/advtszn">twitter</Link>
      </li>
      <li class="underline underline-offset-4 font-medium">
        <Link target="_blank" href="https://github.com/advtszn">github</Link>
      </li>
      <li class="underline underline-offset-4 font-medium">
        <Link target="_blank" href="https://cal.com/advtszn">cal</Link>
      </li>
    </ul>
  </div>
</section>
