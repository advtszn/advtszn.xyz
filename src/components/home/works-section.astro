---
import { ArrowUpRight } from "lucide-astro";
import WorkCard from "~/components/works/work-card.astro";
import { getSortedWorks } from "~/lib/works";

const works = (await getSortedWorks()).slice(0, 6);
---

<section class="space-y-6">
  <div class="max-w-xl mx-auto px-4 lg:px-0">
    <div class="flex items-end justify-between border-b pb-2">
      <h2 class="text-2xl text-foreground font-medium">works</h2>
      <a
        href={"/works"}
        class="inline-flex items-center gap-x-1 text-sm font-medium hover:text-foreground transition-colors group"
      >
        view all
        <ArrowUpRight
          class="size-3 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
        />
      </a>
    </div>
  </div>

  <div class="lg:px-24 px-4">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-x-2"
    >
      {works.map((work) => <WorkCard work={work} compact loading="eager" />)}
    </div>
  </div>
</section>
