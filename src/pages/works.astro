---
import Container from "~/components/common/container.astro";
import WorksList from "~/components/works/works-list";
import Layout from "~/layouts/Layout.astro";
import { getSortedWorks } from "~/lib/works";

const works = (await getSortedWorks()).map(({ id, data }) => ({ id, ...data }));
---

<Layout
  content={{
    title: "works | advtszn",
    description:
      "products and experiments i am/was affiliated with, with case studies of selected works",
  }}
>
  <main>
    <Container>
      <div class="space-y-4">
        <div class="space-y-4 lg:max-w-[45%]">
          <h1 class="font-heading text-3xl font-medium md:text-5xl">works</h1>
          <p class="text-muted-foreground text-lg text-justify">
            products and experiments i am/was affiliated with. pick one for the
            full case study — what it was, what i built, and how it works.
          </p>
        </div>
        <div class="py-6">
          <WorksList works={works} client:load />
        </div>
      </div>
    </Container>
  </main>
</Layout>
