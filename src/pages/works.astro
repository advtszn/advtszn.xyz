---
import WorkCard from "~/components/works/work-card.astro";
import Layout from "~/layouts/Layout.astro";
import { getSortedWorks } from "~/lib/works";
import {
  breadcrumbSchema,
  graph,
  itemListSchema,
  serializeJsonLd,
} from "~/lib/seo";

const works = await getSortedWorks();

const jsonLd = serializeJsonLd(
  graph([
    {
      "@type": "CollectionPage",
      "@id": `${Astro.url.href}#page`,
      name: "works",
      isPartOf: { "@id": `${Astro.site}#website` },
      mainEntity: itemListSchema(
        works.map(({ id, data }) => ({ name: data.title, path: `/work/${id}/` })),
        Astro.site,
      ),
    },
    breadcrumbSchema(
      [
        ["home", "/"],
        ["works", "/works/"],
      ],
      Astro.site,
    ),
  ]),
);
---

<Layout
  jsonLd={jsonLd}
  content={{
    title: "works | advtszn",
    description:
      "products and experiments i am/was affiliated with, with case studies of selected works",
  }}
>
  <main class="space-y-6 py-8 pb-12 lg:py-12">
    <div class="mx-auto max-w-xl space-y-4 px-4 lg:px-0">
      <h1
        class="text-2xl font-medium text-foreground border-b pb-2"
      >
        works
      </h1>
    </div>

    <div class="px-4 lg:px-24">
      <div
        class="grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-x-4 lg:grid-cols-3"
      >
        {
          works.map((work, i) => (
            <WorkCard work={work} compact loading={i < 6 ? "eager" : "lazy"} />
          ))
        }
      </div>
    </div>
  </main>
</Layout>
