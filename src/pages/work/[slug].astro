---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { ArrowLeft } from "lucide-astro";
import Container from "~/components/common/container.astro";
import WorkCard from "~/components/works/work-card.astro";
import Layout from "~/layouts/Layout.astro";
import { getSortedWorks } from "~/lib/works";

export const getStaticPaths = (async () => {
  const works = await getSortedWorks();
  return works.map((work, i) => ({
    params: { slug: work.id },
    props: {
      work,
      others: [1, 2, 3]
        .map((offset) => works[(i + offset) % works.length])
        .filter((other) => other.id !== work.id),
    },
  }));
}) satisfies GetStaticPaths;

const { work, others } = Astro.props;
const { Content } = await render(work);

const formatDate = (date: Date): string => {
  const month = String(date.getMonth() + 1).padStart(2, "0");
  return `${month}/${date.getFullYear()}`;
};
---

<Layout
  content={{
    title: `${work.data.title} | advtszn`,
    description: work.data.overview,
  }}
>
  <main>
    <Container>
      <div class="space-y-6">
        <a
          href="/works"
          class="text-muted-foreground hover:text-foreground flex text-sm font-medium items-center pt-2 transition-colors group w-fit"
        >
          <ArrowLeft
            size={16}
            class="mr-1.5 transition-transform group-hover:-translate-x-0.5"
          /> back to works
        </a>
        <div class="flex items-center justify-between mb-12">
          <h1 class="font-heading text-3xl font-medium text-foreground">
            {work.data.title}
          </h1>
          <p class="font-medium text-sm text-muted-foreground tabular-nums">
            {formatDate(work.data.date)}
          </p>
        </div>

        <div
          class="flex flex-col gap-12 md:flex-row items-start justify-between"
        >
          <div class="md:w-1/2">
            <div class="flex gap-6 md:gap-12 flex-col">
              <div class="space-y-1">
                <h2 class="font-heading text-foreground font-medium">
                  timeline
                </h2>
                <p class="text-muted-foreground font-prose">{work.data.timeline}</p>
              </div>
              <div class="space-y-1">
                <h2 class="font-heading text-foreground font-medium">live</h2>
                <p class="text-muted-foreground font-prose">
                  {
                    work.data.url ? (
                      <a
                        href={work.data.url}
                        target="_blank"
                        class="underline underline-offset-3 decoration-muted-foreground hover:decoration-foreground hover:text-foreground transition-colors"
                      >
                        {work.data.url
                          .replace(/^https?:\/\//, "")
                          .replace(/\/$/, "")}
                      </a>
                    ) : (
                      "not available"
                    )
                  }
                </p>
              </div>
              <div class="space-y-1">
                <h2 class="font-heading text-foreground font-medium">tech</h2>
                <p class="text-muted-foreground font-prose">{work.data.tech.join(", ")}</p>
              </div>
            </div>
          </div>

          <div class="md:w-1/2">
            <div class="flex gap-6 md:gap-12 flex-col">
              <div class="space-y-1">
                <h2 class="font-heading text-foreground font-medium">
                  overview
                </h2>
                <p class="text-muted-foreground text-justify font-prose">
                  {work.data.overview}
                </p>
              </div>
              <div class="space-y-1">
                <h2 class="font-heading text-foreground font-medium">
                  what i built
                </h2>
                <p class="text-muted-foreground text-justify font-prose">
                  {work.data.contribution}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>

    <Container className="py-0">
      <article class="mdx space-y-6 mb-20">
        <Content />
      </article>
      {
        others.length > 0 && (
          <div class="mb-20 py-10 border-t space-y-6">
            <h2 class="font-heading text-foreground text-2xl font-medium">
              more works
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-x-2">
              {others.map((other) => (
                <WorkCard work={other} compact />
              ))}
            </div>
          </div>
        )
      }
    </Container>
  </main>
</Layout>
