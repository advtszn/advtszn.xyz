---
import Layout from "../layouts/Layout.astro";
import HeroSection from "~/components/home/hero-section.astro";
import WorksSection from "~/components/home/works-section.astro";
import WritingsSection from "~/components/home/writings-section.astro";
import SocialsSection from "~/components/home/socials-section.astro";
import { graph, personSchema, serializeJsonLd, websiteSchema } from "~/lib/seo";

const birthDate = new Date("2007-08-28");
const today = new Date();

const age =
  today.getMonth() > birthDate.getMonth() ||
  (today.getMonth() === birthDate.getMonth() &&
    today.getDate() >= birthDate.getDate())
    ? today.getFullYear() - birthDate.getFullYear()
    : today.getFullYear() - birthDate.getFullYear() - 1;

const jsonLd = serializeJsonLd(
  graph([
    personSchema(Astro.site),
    websiteSchema(Astro.site),
    {
      "@type": "ProfilePage",
      "@id": `${Astro.url.href}#page`,
      mainEntity: { "@id": `${Astro.site}#person` },
      isPartOf: { "@id": `${Astro.site}#website` },
    },
  ]),
);
---

<Layout
  jsonLd={jsonLd}
  content={{
    title: "home | advtszn",
    description: `${age} year old multi-disciplinary engineer, obsessed with scale, speed and aesthetics`,
  }}
>
  <div class="space-y-12 lg:space-y-20 py-10 pb-20 lg:py-12">
    <HeroSection age={age} />
    <WorksSection />
    <WritingsSection />
    <SocialsSection />
  </div>
</Layout>
