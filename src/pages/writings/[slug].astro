---
import Container from "~/components/common/container.astro";
import Layout from "~/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { ArrowLeft } from "lucide-astro";
import {
  absoluteUrl,
  breadcrumbSchema,
  graph,
  serializeJsonLd,
  SITE,
} from "~/lib/seo";

export async function getStaticPaths() {
  const writings = await getCollection("writings");

  return writings.map((writing) => ({
    params: { slug: writing.id },
    props: { writing },
  }));
}

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  });

const { writing } = Astro.props;
const { Content } = await render(writing);

const jsonLd = serializeJsonLd(
  graph([
    {
      "@type": "BlogPosting",
      "@id": `${Astro.url.href}#article`,
      headline: writing.data.title,
      description: writing.data.description,
      datePublished: writing.data.date.toISOString(),
      dateModified: writing.data.date.toISOString(),
      inLanguage: "en",
      image: absoluteUrl("/og-image.png", Astro.site),
      author: { "@type": "Person", name: SITE.author, url: absoluteUrl("/", Astro.site) },
      publisher: { "@type": "Person", name: SITE.author, url: absoluteUrl("/", Astro.site) },
      mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url.href },
      isPartOf: { "@id": `${Astro.site}#website` },
    },
    breadcrumbSchema(
      [
        ["home", "/"],
        ["writings", "/writings/"],
        [writing.data.title, `/writings/${writing.id}/`],
      ],
      Astro.site,
    ),
  ]),
);
---

<Layout
  jsonLd={jsonLd}
  content={{
    title: `${writing.data.title} | advtszn`,
    description: writing.data.description,
    type: "article",
    publishedTime: writing.data.date,
  }}
>
  <main>
    <Container>
      <div class="space-y-6">
        <div class="mx-auto max-w-xl space-y-6">
          <a
            href="/writings"
            class="text-muted-foreground hover:text-foreground group flex w-fit items-center pt-2 text-sm transition-colors"
            ><ArrowLeft
              size={16}
              class="mr-1.5 transition-transform group-hover:-translate-x-0.5"
            /> back to writings</a
          >
          <div
            class="mb-12 flex flex-col gap-y-4 lg:flex-row lg:justify-between lg:items-baseline lg:gap-y-0"
          >
            <h1 class="text-foreground text-3xl font-medium">
              {writing.data.title}
            </h1>
            <p
              class="text-muted-foreground text-sm font-medium whitespace-nowrap tabular-nums"
            >
              {formatDate(writing.data.date)}
            </p>
          </div>
        </div>
        <article class="mdx mb-20 space-y-6">
          <Content />
        </article>
      </div>
    </Container>
  </main>
</Layout>
