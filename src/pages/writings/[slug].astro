---
import Container from "~/components/common/container.astro";
import Layout from "~/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { ArrowLeft, ChevronLeft, ChevronRight } from "lucide-astro";
import {
  absoluteUrl,
  breadcrumbSchema,
  graph,
  serializeJsonLd,
  SITE,
} from "~/lib/seo";

export async function getStaticPaths() {
  // Same order as the writings index: newest first. "Previous" is the newer
  // post, "Next" the older one, so Next keeps reading down the list.
  const writings = (await getCollection("writings")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return writings.map((writing, i) => ({
    params: { slug: writing.id },
    props: { writing, prev: writings[i - 1], next: writings[i + 1] },
  }));
}

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  });

const { writing, prev, next } = Astro.props;
const { Content } = await render(writing);

const jsonLd = serializeJsonLd(
  graph([
    {
      "@type": "BlogPosting",
      "@id": `${Astro.url.href}#article`,
      headline: writing.data.title,
      description: writing.data.description,
      datePublished: writing.data.date.toISOString(),
      dateModified: writing.data.date.toISOString(),
      inLanguage: "en",
      image: absoluteUrl("/og-image.png", Astro.site),
      author: { "@type": "Person", name: SITE.author, url: absoluteUrl("/", Astro.site) },
      publisher: { "@type": "Person", name: SITE.author, url: absoluteUrl("/", Astro.site) },
      mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url.href },
      isPartOf: { "@id": `${Astro.site}#website` },
    },
    breadcrumbSchema(
      [
        ["home", "/"],
        ["writings", "/writings/"],
        [writing.data.title, `/writings/${writing.id}/`],
      ],
      Astro.site,
    ),
  ]),
);
---

<Layout
  jsonLd={jsonLd}
  content={{
    title: `${writing.data.title} | advait.`,
    description: writing.data.description,
    type: "article",
    publishedTime: writing.data.date,
  }}
>
  <main>
    <Container>
      <div class="space-y-6">
        <div class="mx-auto max-w-xl space-y-6">
          <a
            href="/writings"
            class="text-muted-foreground hover:text-foreground group flex w-fit items-center pt-2 text-sm transition-colors"
            ><ArrowLeft
              size={16}
              class="mr-1.5 transition-transform group-hover:-translate-x-0.5"
            /> back to writings</a
          >
          <div
            class="mb-12 flex flex-col gap-y-4"
          >
            <h1 class="text-foreground text-3xl font-medium">
              {writing.data.title}
            </h1>
            <p
              class="text-muted-foreground text-sm font-medium whitespace-nowrap tabular-nums"
            >
              {formatDate(writing.data.date)}
            </p>
          </div>
        </div>
        <article class="mdx mb-16 space-y-6">
          <Content />
        </article>
        {(prev || next) && (
          <nav
            aria-label="More writings"
            class="border-border mx-auto mb-20 grid w-full max-w-4xl grid-cols-2 gap-6 border-t pt-8"
          >
            {prev && (
              <a
                href={`/writings/${prev.id}/`}
                class="group col-start-1 flex flex-col items-start gap-y-2"
              >
                <span class="text-muted-foreground flex items-center gap-x-1 text-sm">
                  <ChevronLeft
                    size={16}
                    class="transition-transform group-hover:-translate-x-0.5"
                  />
                  Previous
                </span>
                <span class="text-foreground/80 group-hover:text-foreground font-medium transition-colors">
                  {prev.data.title}
                </span>
              </a>
            )}
            {next && (
              <a
                href={`/writings/${next.id}/`}
                class="group col-start-2 flex flex-col items-end gap-y-2 text-right"
              >
                <span class="text-muted-foreground flex items-center gap-x-1 text-sm">
                  Next
                  <ChevronRight
                    size={16}
                    class="transition-transform group-hover:translate-x-0.5"
                  />
                </span>
                <span class="text-foreground/80 group-hover:text-foreground font-medium transition-colors">
                  {next.data.title}
                </span>
              </a>
            )}
          </nav>
        )}
      </div>
    </Container>
  </main>
</Layout>
