---
import { getCollection } from "astro:content";
import Link from "~/components/common/link.astro";
import Layout from "~/layouts/Layout.astro";
import {
  breadcrumbSchema,
  graph,
  itemListSchema,
  serializeJsonLd,
} from "~/lib/seo";

const writings = (await getCollection("writings")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const jsonLd = serializeJsonLd(
  graph([
    {
      "@type": "CollectionPage",
      "@id": `${Astro.url.href}#page`,
      name: "writings",
      isPartOf: { "@id": `${Astro.site}#website` },
      mainEntity: itemListSchema(
        writings.map(({ id, data }) => ({
          name: data.title,
          path: `/writings/${id}/`,
        })),
        Astro.site,
      ),
    },
    breadcrumbSchema(
      [
        ["home", "/"],
        ["writings", "/writings/"],
      ],
      Astro.site,
    ),
  ]),
);
---

<Layout
  jsonLd={jsonLd}
  content={{
    title: "writings | advtszn",
    description:
      "notes on things i'm learning and building, written up as i go",
  }}
>
  <main class="space-y-6 py-8 pb-12 lg:py-12">
    <div class="mx-auto max-w-xl space-y-4 px-4 lg:px-0">
      <h1
        class="text-2xl font-medium text-foreground border-b pb-2"
      >
        writings
      </h1>
    </div>

    <div class="mx-auto max-w-xl px-4 lg:px-0">
      <ol class="space-y-2.5">
        {
          writings.map(({ id, data: { title } }) => (
            <li class="pl-1.5 text-lg">
              <Link href={`/writings/${id}`}>{title}</Link>
            </li>
          ))
        }
      </ol>
    </div>
  </main>
</Layout>
