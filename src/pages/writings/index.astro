---
import { getCollection } from "astro:content";
import Link from "~/components/common/link.astro";
import Layout from "~/layouts/Layout.astro";

const writings = (await getCollection("writings")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
  content={{
    title: "writings | advtszn",
    description:
      "notes on things i'm learning and building, written up as i go",
  }}
>
  <main class="space-y-6 py-8 pb-12 lg:py-12">
    <div class="mx-auto max-w-xl space-y-4 px-4 lg:px-0">
      <h1
        class="font-heading text-2xl font-medium text-foreground border-b pb-2"
      >
        writings
      </h1>
    </div>

    <div class="mx-auto max-w-xl px-4 lg:px-0">
      <ol class="space-y-2.5">
        {
          writings.map(({ id, data: { title } }) => (
            <li class="pl-1.5 text-lg">
              <Link href={`/writings/${id}`}>{title}</Link>
            </li>
          ))
        }
      </ol>
    </div>
  </main>
</Layout>
